{
  "providers": {
    "planner": "codex",
    "build_orchestrator": "claude",
    "builder": "claude",
    "testing": "codex",
    "architecture": "claude",
    "ui": "codex",
    "ux": "claude",
    "security": "codex"
  },
  "models": {
    "planner": "gpt-6-sol",
    "build_orchestrator": "claude-opus-5-5",
    "builder": "claude-haiku-5-5",
    "testing": "gpt-6-luna",
    "architecture": "claude-haiku-5-5",
    "ui": "gpt-6-luna",
    "ux": "claude-haiku-5-5",
    "security": "gpt-6-luna"
  },
  "max_review_rounds": 3,
  "max_agent_seconds": 1200,
  "max_gate_seconds": 600,
  "claude_max_turns": 60,
  "claude_budget_usd_per_call": 10.0,
  "required_gates": [
    "tests",
    "lint",
    "security",
    "build"
  ],
  "ui_required_gate": "ui_e2e",
  "commands": {
    "tests": [
      [
        "npm",
        "test",
        "--",
        "--run"
      ]
    ],
    "lint": [
      [
        "npm",
        "run",
        "lint"
      ]
    ],
    "security": [
      [
        "npm",
        "audit",
        "--audit-level=high"
      ]
    ],
    "build": [
      [
        "npm",
        "run",
        "build"
      ]
    ],
    "ui_e2e": [
      [
        "npx",
        "playwright",
        "test"
      ]
    ]
  }
}
